{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "abyss-cycle.schema.json",
  "title": "AbyssCycle",
  "description": "Dữ liệu quái Trầm Thủy của một chu kỳ 2 tuần (tầng 9-12).",
  "type": "object",
  "required": ["periodStart", "periodEnd", "gameVersion", "blessingOfTheAbyssalMoon", "floors"],
  "properties": {
    "periodStart": { "type": "string", "format": "date" },
    "periodEnd": { "type": "string", "format": "date" },
    "gameVersion": { "type": "string" },
    "mechanicNotes": { "type": "string", "description": "Ghi chú cơ chế mới/đặc biệt của bản này (vd. Stellar Glimmer Reaction)" },
    "blessingOfTheAbyssalMoon": {
      "type": "object",
      "required": ["name", "description", "timeStart", "timeEnd"],
      "description": "Buff áp dụng cho TOÀN BỘ Trầm Thủy (mọi tầng 1-12) suốt cả chu kỳ — khác với leyLineDisorder trong floors[] vốn chỉ áp dụng riêng từng tầng 9-12.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "timeStart": { "type": "string" },
        "timeEnd": { "type": "string" },
        "relatedMechanic": { "type": ["string", "null"], "description": "Cơ chế nền liên quan nếu buff gắn với 1 phản ứng/hiệu ứng cụ thể (vd. Polestar Field / Stellar-Conduct)" }
      }
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["floor", "leyLineDisorder", "chambers", "recommendation"],
        "properties": {
          "floor": { "type": "integer" },
          "leyLineDisorder": { "type": "string" },
          "chambers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chamber", "monsterLevel", "waves"],
              "properties": {
                "chamber": { "type": "integer" },
                "monsterLevel": { "type": ["integer", "null"] },
                "waves": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["wave", "monsters"],
                    "properties": {
                      "wave": { "type": "integer" },
                      "monsters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["name", "count", "size", "elements", "weakpoint"],
                          "properties": {
                            "name": { "type": "string" },
                            "count": { "type": "string" },
                            "size": { "type": "string", "description": "Nhỏ/Vừa/Lớn/Trùm" },
                            "elements": { "type": "array", "items": { "type": "string" }, "description": "Nguyên tố tấn công/khiên" },
                            "resistanceNotes": { "type": ["string", "null"] },
                            "weakpoint": { "type": ["boolean", "null"] },
                            "mechanics": { "type": ["string", "null"] },
                            "hpRatio": { "type": ["string", "null"] },
                            "gameId": { "type": "integer", "description": "Id số của game cho quái này, do scripts/sync-abyss-monster-resistance.py ghi từ gi.yatta.moe. Vắng mặt = script chưa khớp được tên quái này (xem README của thư mục abyss-monsters)." },
                            "resistances": {
                              "type": "object",
                              "description": "Kháng nguyên tố THẬT của quái, lấy thẳng từ file game qua gi.yatta.moe — không phải suy đoán. Có đủ 7 nguyên tố khi có mặt, kể cả những nguyên tố ở baseline 10% (đó cũng là thông tin thật: quái KHÔNG kháng thêm nguyên tố đó). resistanceNotes (transcribed từ wiki) vẫn thắng field này nếu cả hai cùng nói về một nguyên tố — resistanceNotes có thể ghi trạng thái động trong trận (vd. 'kháng Pyro -220% khi Rooted') mà bảng tĩnh của game không thấy được.",
                              "properties": {
                                "Anemo": { "type": "number" }, "Geo": { "type": "number" },
                                "Electro": { "type": "number" }, "Dendro": { "type": "number" },
                                "Hydro": { "type": "number" }, "Pyro": { "type": "number" },
                                "Cryo": { "type": "number" }
                              }
                            },
                            "physicalResistance": { "type": "number", "description": "Kháng Vật Lý thật của quái, cùng nguồn. Ghi lại nhưng CHƯA được engine dùng: không nhân vật nào có damage được mô hình hoá là Vật Lý." }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
