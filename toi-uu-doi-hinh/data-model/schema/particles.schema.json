{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "particles.schema.json",
  "title": "Particles",
  "description": "Số hạt nguyên tố Kỹ năng Nguyên tố tạo ra, theo template {{Talent Note|particles|...}} trên trang kỹ năng của Genshin Impact Wiki. SINH TỰ ĐỘNG bằng scripts/sync-abyss-particles.py. Số liệu cộng đồng đo (đối chiếu gcsim), không phải file game. Dạng 'mỗi sự kiện' cần character-kits.json → energy.eventsPerCast.",
  "type": "object",
  "required": [
    "characters"
  ],
  "properties": {
    "_doc": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "fetchedOn": {
      "type": "string",
      "format": "date"
    },
    "characters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "page",
          "revid",
          "notes",
          "readings"
        ],
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "string",
            "description": "Tiêu đề trang wiki sau redirect."
          },
          "revid": {
            "type": "integer",
            "description": "Revision id lúc lấy — để tra lại đúng bản đã đọc."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Tham số template nguyên văn (bỏ 'particles')."
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "press": {
                  "type": "number",
                  "minimum": 0
                },
                "hold": {
                  "type": "number",
                  "minimum": 0
                },
                "perEvent": {
                  "type": "object",
                  "required": [
                    "event",
                    "count"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "event": {
                      "type": "string"
                    },
                    "count": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "press"
                  ]
                },
                {
                  "required": [
                    "perEvent"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}
