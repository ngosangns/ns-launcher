{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "artifact-set.schema.json",
  "title": "ArtifactSet",
  "type": "object",
  "required": ["id", "name", "rarity", "twoPiece", "fourPiece", "domain", "region", "bestCharacters", "sourceFile"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string" },
    "rarity": { "type": "string", "description": "vd. '4-5', '1-4', '5'" },
    "twoPiece": {
      "type": "object",
      "required": ["description", "bonuses"],
      "properties": {
        "description": { "type": "string" },
        "bonuses": {
          "type": "array",
          "description": "Best-effort tách số liệu; rỗng nếu hiệu ứng không phải buff % chỉ số đơn giản",
          "items": {
            "type": "object",
            "required": ["stat", "value"],
            "properties": { "stat": { "type": "string" }, "value": { "type": "number" } }
          }
        }
      }
    },
    "fourPiece": {
      "type": "object",
      "required": ["description", "bonuses"],
      "properties": {
        "description": { "type": "string" },
        "bonuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stat", "value"],
            "properties": { "stat": { "type": "string" }, "value": { "type": "number" } }
          }
        }
      }
    },
    "domain": { "type": ["string", "null"] },
    "region": { "type": ["string", "null"] },
    "bestCharacters": { "type": "array", "items": { "type": "string" } },
    "sourceFile": { "type": "string" }
  }
}
